# Makefile configuration variables.

APP_NAME=ohif-viewer
IMAGE_REPO=containers.renci.org/helxplatform
VERSION=v0.1.0

# Which of platform/app/public/config/*.js is baked in as app-config.js. It can
# still be replaced at container start via $APP_CONFIG or $APP_CONFIG_FILE.
APP_CONFIG=config/default.js

# Built in place of the URL prefix, then substituted for the real one at
# container start. Must be a legal URL path, and distinctive enough that a
# textual substitution over the built assets cannot hit anything else.
PUBLIC_URL_SENTINEL=/__HELX_PUBLIC_URL__/

# These variables are used when running the container locally.
CONTAINER_PORT=8080
HOST_PORT=8080
DOCKER_RUN_ENV_FILE=docker-run.env
# UID of 1015180002 is similar to what would be used on OpenShift; the HeLx
# dev/test clusters launch apps as 30000:1136. Either way the image must not
# assume it owns its own files.
UID=1015180002
GID=0
PLATFORM=linux/amd64
