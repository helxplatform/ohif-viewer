# Rendered to /etc/nginx/conf.d/default.conf by /start-ohif.sh, which passes
# envsubst an explicit list of three variables -- HELX_PORT, HELX_HTML_DIR and
# HELX_REWRITE -- so that every other dollar sign below reaches nginx intact.
# Do not spell those three in substitution syntax outside the places they are
# meant to expand, comments included.

server {
    listen      ${HELX_PORT} default_server;
    listen      [::]:${HELX_PORT} default_server;
    server_name _;

    root  ${HELX_HTML_DIR};
    index index.html;

    # Redirects must keep the /private/... prefix the client came in on, and
    # nginx only knows the prefix-stripped URI by the time it emits one.
    absolute_redirect off;

    # Most of the build is pre-compressed (.helx/prepare-dist.sh); the files
    # rewritten at startup are not, and get compressed on the fly instead.
    gzip_static     always;
    gzip_proxied    expired no-cache no-store private auth;
    gunzip          on;
    gzip            on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types      text/plain text/css application/javascript application/json
                    application/wasm image/svg+xml;

    ${HELX_REWRITE}

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Bookkeeping left in the served tree by prepare-dist.sh / start-ohif.sh.
    location ~ ^/\.helx- {
        return 404;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cross-Origin-Resource-Policy same-origin;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root ${HELX_HTML_DIR};
    }
}
